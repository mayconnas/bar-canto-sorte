# Credenciais do Supabase (Project Settings > API)
# Copie este arquivo para .env e preencha com os valores do seu projeto.
#
# Deixe vazio para rodar o app em modo 100% offline (somente SQLite local).
#
# ATENCAO: variaveis EXPO_PUBLIC_ sao embutidas em texto puro no bundle
# compilado. Use apenas a chave anonima (anon/public), nunca a service_role.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
